# WeatherWay Environment Configuration Template
# ------------------------------------------------------------------------------
# Backend Configuration (copy to Backend/.env)
# ------------------------------------------------------------------------------
# PostgreSQL database for user auth and vehicle garages
DATABASE_URL=postgresql://weatherway:weatherway@localhost:5433/weatherway

# Optional. Without a token, live routes use OSRM public demo server.
MAPBOX_ACCESS_TOKEN=

# Journey Agent LLM integration via OpenRouter
# Server-only API key; never expose as a client VITE_ variable.
# For free tier models (e.g. $0 balance limit), set OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ------------------------------------------------------------------------------
# Frontend Configuration (copy to Frontend/.env)
# ------------------------------------------------------------------------------
# Google Maps JavaScript API Client Key
# Browser key: restrict by HTTP referrer.
# Requires: Maps JavaScript API, Places API, Places API (New), Geocoding API, and Routes API.
# When omitted or restricted, WeatherWay gracefully falls back to Leaflet and Nominatim.
VITE_GOOGLE_MAPS_API_KEY=
