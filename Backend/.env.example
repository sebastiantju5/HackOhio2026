# Database connection for user profiles, saved vehicles, and authenticated sessions
DATABASE_URL=postgresql://weatherway:weatherway@localhost:5433/weatherway

# Optional. Without a Mapbox token, live routes use the OSRM public demo server (no traffic).
MAPBOX_ACCESS_TOKEN=

# Journey Agent LLM integration via OpenRouter
# Server-only API key; never expose as a client VITE_ variable.
# For free tier models (e.g. $0 balance limit), set OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Local LLM configuration (OpenAI-compatible endpoints)
# Set USE_LOCAL_LLM=true to use a local OpenAI-compatible server instead of OpenRouter (openrouter/free)
# Available endpoints:
# - http://192.168.1.142:11434/v1 (fast 8k context, ~2.5s response)
# - http://192.168.1.211:11434/v1 (32k context)
USE_LOCAL_LLM=false
LOCAL_LLM_BASE_URL=http://192.168.1.142:11434/v1
LOCAL_LLM_MODEL=/models/Ling-3.0-tiny-Q5_K_M.gguf

